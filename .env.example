# Copier ce fichier vers .env à la racine, sans écraser un .env existant.
# Musée documentaire : aucun identifiant requis pour les aperçus --dry-run.
AWS_REGION=eu-west-3
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0

# Option A : clé API Bedrock. Ne pas utiliser une clé OpenAI ici.
AWS_BEARER_TOKEN_BEDROCK=
# Option B : profil AWS configuré localement (IAM ou SSO).
# AWS_PROFILE=mon-profil

# Dossier administrateur, relatif à la racine du projet ou absolu.
MUSEUM_DATA_DIR=data

# Expérimentation facultative : python -m my_art.generate_views
# Indépendante du musée. Clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
