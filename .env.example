# Copier ce fichier vers .env puis renseigner la clé LOCALEMENT.
# Créer une clé : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Modèle d'édition d'images, distinct du modèle de conversation.
OPENAI_IMAGE_MODEL=gpt-image-2

# Musée Bedrock : indépendant de la clé OpenAI ci-dessus.
AWS_REGION=eu-west-3
BEDROCK_MODEL_ID=eu.amazon.nova-pro-v1:0

# Option A : clé API Bedrock. Ne pas utiliser une clé OpenAI ici.
AWS_BEARER_TOKEN_BEDROCK=
# Option B : profil AWS configuré localement (IAM ou SSO).
# AWS_PROFILE=mon-profil

# Dossier administrateur, relatif à la racine du projet ou absolu.
MUSEUM_DATA_DIR=data
