AWS_REGION=eu-west-3

# Option 1: credentials AWS classiques (si tu as des access_key/secret)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_SESSION_TOKEN=YOUR_AWS_SESSION_TOKEN

# Option 2: token partagé via proxy / endpoint Bedrock mutualisé
AWS_BEARER_TOKEN_BEDROCK=YOUR_BEDROCK_BEARER_TOKEN
BEDROCK_ENDPOINT_URL=https://example.com/bedrock

BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
RAG_DIR=./data/rag
OUTPUT_DIR=./outputs
LOG_LEVEL=INFO
